@model SFA.DAS.FAA.Web.Models.User.DateOfBirthViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}
@section BackLink {
    <a class="govuk-back-link" asp-route="@Model.BackLink" asp-route-journeyPath="@Model.JourneyPath">Back</a>
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_ValidationSummary" />
        <span class="govuk-caption-l">
            @Model.PageCaption
        </span>
        <form class="form" method="post">
            <input type="hidden" asp-for="@Model.JourneyPath" />
            <input type="hidden" asp-for="BackLink" />
            <h1 class="govuk-heading-l">
                @Model.PageHeading
            </h1>
            <p class="govuk-body">We'll use your age to:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>check that you're old enough to use this service</li>
                <li>check if you can apply for foundation apprenticeships</li>
                <li>calculate the correct minimum wage for you</li>
            </ul>
            <p class="govuk-body">We also monitor which age groups use our service to help us make improvements.</p>
            <fieldset class="govuk-fieldset" role="group" aria-describedby="DateOfBirthHint">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                    <h2 class="govuk-fieldset__heading">What is your date of birth?</h2>    
                </legend>
                <day-month-year-date property="DateOfBirth" label="" hint-text="For example, 31 03 1980" error-class="govuk-form-group--error" />
            </fieldset>
            <button class="govuk-button" data-module="govuk-button">
                @Model.PageCtaButtonLabel
            </button>
        </form>
    </div>
</div>